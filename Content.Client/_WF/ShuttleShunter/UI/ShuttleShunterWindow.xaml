<DefaultWindow xmlns="https://spacestation14.io"
               MinSize="310 200"
               SetSize="310 200"
               Title="{Loc 'shuttle-shunter-window-title'}">
    <BoxContainer Orientation="Vertical" Margin="8 8 8 8" SeparationOverride="6">
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Label Text="{Loc 'shuttle-shunter-label-name'}" MinWidth="90" StyleClasses="LabelSubText"/>
            <Label Name="ShuttleNameLabel" HorizontalExpand="True"/>
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Label Text="{Loc 'shuttle-shunter-label-owner'}" MinWidth="90" StyleClasses="LabelSubText"/>
            <Label Name="ShuttleOwnerLabel" HorizontalExpand="True"/>
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Label Text="{Loc 'shuttle-shunter-label-value'}" MinWidth="90" StyleClasses="LabelSubText"/>
            <Label Name="ShuttleValueLabel" HorizontalExpand="True"/>
        </BoxContainer>
        <Button Name="ShuntButton"
                Text="{Loc 'shuttle-shunter-button-shunt'}"
                Margin="0 8 0 0"
                StyleClasses="Caution"/>
    </BoxContainer>
</DefaultWindow>
