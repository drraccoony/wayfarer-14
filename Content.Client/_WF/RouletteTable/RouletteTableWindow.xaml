<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      MinSize="980 600">
    <BoxContainer Orientation="Horizontal" Margin="10">

        <!-- LEFT: Betting Board -->
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="0 0 10 0">
            <Label Text="{Loc 'roulette-table-place-bets'}" StyleClasses="LabelSubHeading"
                   HorizontalAlignment="Center" Margin="0 0 0 8"/>

            <!-- Number grid row: 0 button | 12x3 number grid | 2-to-1 column buttons -->
            <BoxContainer Orientation="Horizontal" Margin="0 0 0 4">
                <Button Name="ZeroButton" Text="0" MinSize="44 90" Margin="0 0 2 0"/>
                <GridContainer Name="NumberGrid" Columns="12" HorizontalExpand="True"/>
                <BoxContainer Orientation="Vertical" Margin="2 0 0 0">
                    <Button Name="Col3Button" Text="2:1" MinSize="44 28" Margin="0 0 0 2" ToolTip="{Loc 'roulette-bet-column-3'}"/>
                    <Button Name="Col2Button" Text="2:1" MinSize="44 28" Margin="0 0 0 2" ToolTip="{Loc 'roulette-bet-column-2'}"/>
                    <Button Name="Col1Button" Text="2:1" MinSize="44 28" ToolTip="{Loc 'roulette-bet-column-1'}"/>
                </BoxContainer>
            </BoxContainer>

            <!-- Dozen bets (offset to align with number grid, not the 0 or column buttons) -->
            <BoxContainer Orientation="Horizontal" Margin="46 0 46 3">
                <Button Name="Dozen1Button" Text="{Loc 'roulette-bet-dozen-1'}" HorizontalExpand="True" MinSize="0 28" Margin="0 0 2 0"/>
                <Button Name="Dozen2Button" Text="{Loc 'roulette-bet-dozen-2'}" HorizontalExpand="True" MinSize="0 28" Margin="0 0 2 0"/>
                <Button Name="Dozen3Button" Text="{Loc 'roulette-bet-dozen-3'}" HorizontalExpand="True" MinSize="0 28"/>
            </BoxContainer>

            <!-- Outside bets row -->
            <BoxContainer Orientation="Horizontal" Margin="46 0 46 0">
                <Button Name="LowButton"   Text="{Loc 'roulette-bet-low'}"   HorizontalExpand="True" MinSize="0 28" Margin="0 0 2 0"/>
                <Button Name="EvenButton"  Text="{Loc 'roulette-bet-even'}"  HorizontalExpand="True" MinSize="0 28" Margin="0 0 2 0"/>
                <Button Name="RedButton"   Text="{Loc 'roulette-bet-red'}"   HorizontalExpand="True" MinSize="0 28" Margin="0 0 2 0"/>
                <Button Name="BlackButton" Text="{Loc 'roulette-bet-black'}" HorizontalExpand="True" MinSize="0 28" Margin="0 0 2 0"/>
                <Button Name="OddButton"   Text="{Loc 'roulette-bet-odd'}"   HorizontalExpand="True" MinSize="0 28" Margin="0 0 2 0"/>
                <Button Name="HighButton"  Text="{Loc 'roulette-bet-high'}"  HorizontalExpand="True" MinSize="0 28"/>
            </BoxContainer>
        </BoxContainer>

        <!-- RIGHT: Controls Panel -->
        <BoxContainer Orientation="Vertical" MinSize="230 0">

            <!-- Balance section -->
            <PanelContainer StyleClasses="AngleRect" Margin="0 0 0 8">
                <BoxContainer Orientation="Vertical" Margin="8">
                    <Label Text="{Loc 'roulette-table-balance-label'}" StyleClasses="LabelSubHeading"
                           HorizontalAlignment="Center"/>
                    <Label Name="TableBalanceLabel" Text="0 ₮" StyleClasses="LabelBig"
                           HorizontalAlignment="Center"/>
                    <Label Text="{Loc 'roulette-deposit-hint'}" StyleClasses="LabelSecondaryColor LabelSubText"
                           HorizontalAlignment="Center" Margin="0 2 0 0"/>
                </BoxContainer>
            </PanelContainer>
            <Label Text="{Loc 'roulette-bet-amount-label'}" StyleClasses="LabelSubHeading" Margin="0 0 0 5"/>
            <LineEdit Name="BetAmountEdit" PlaceHolder="{Loc 'roulette-bet-amount-placeholder'}"
                      HorizontalExpand="True" Margin="0 0 0 5"/>

            <!-- Preset amount buttons -->
            <BoxContainer Orientation="Horizontal" Margin="0 0 0 3">
                <Button Name="Bet100Button"  Text="100"  HorizontalExpand="True" Margin="0 0 2 0"/>
                <Button Name="Bet500Button"  Text="500"  HorizontalExpand="True" Margin="0 0 2 0"/>
                <Button Name="Bet1000Button" Text="1K"   HorizontalExpand="True" Margin="0 0 2 0"/>
                <Button Name="Bet5000Button" Text="5K"   HorizontalExpand="True" Margin="0 0 2 0"/>
                <Button Name="BetMaxButton"  Text="MAX"  HorizontalExpand="True"/>
            </BoxContainer>

            <Button Name="ClearMyBetsButton" Text="{Loc 'roulette-clear-my-bets'}"
                    StyleClasses="ButtonDanger" Margin="0 5 0 10"/>

            <PanelContainer StyleClasses="AngleRect" MinSize="0 2" Margin="0 0 0 10"/>

            <!-- Current bets list -->
            <Label Text="{Loc 'roulette-current-bets'}" StyleClasses="LabelSubHeading" Margin="0 0 0 5"/>
            <PanelContainer StyleClasses="AngleRect" VerticalExpand="True" ModulateSelfOverride="#0A0A0A">
                <ScrollContainer VerticalExpand="True" Margin="4">
                    <BoxContainer Name="BetsList" Orientation="Vertical" SeparationOverride="2"/>
                </ScrollContainer>
            </PanelContainer>

            <PanelContainer StyleClasses="AngleRect" MinSize="0 2" Margin="0 10 0 5"/>

            <Label Name="LastResultLabel" Text="{Loc 'roulette-no-result'}"
                   HorizontalAlignment="Center" Margin="0 0 0 8"/>

            <Button Name="SpinButton" Text="{Loc 'roulette-spin'}" MinSize="0 48" Margin="0 0 0 5"/>
            <Button Name="CashOutButton" Text="{Loc 'roulette-cash-out'}" MinSize="0 35"/>
        </BoxContainer>

    </BoxContainer>
</controls:FancyWindow>
